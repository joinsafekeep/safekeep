# Netlify Functions environment; never put secret/service-role keys in client code.
SUPABASE_URL=https://iybcbztvofqihvqhqfoo.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_zYE3IWYDB4KSj9UZkbLVBg__SDs-7hr
APP_ORIGIN=https://joinsafekeep.com
# For local development only, use APP_ORIGIN=http://localhost:8888 and COOKIE_SECURE=false.
COOKIE_SECURE=true
# Settings: phone verification through Twilio Verify, and the proof shared with the database (safekeep_private.secrets).
# Prefer a restricted API key; the account SID + auth token pair still works as a fallback.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PHONE_VERIFY_SECRET=
# Scheduled cleanup only (netlify/functions/scheduled-cleanup.mjs). Never expose to request-path functions or the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Billing: Stripe webhook (/api/billing/webhook) and Billing Portal sessions (/api/billing/portal).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Plain emails queued in outbound_emails, sent by netlify/functions/scheduled-email.mjs.
SENDGRID_API_KEY=
EMAIL_FROM=hello@joinsafekeep.com
# Email practice (netlify/functions/scheduled-practice.mjs). Nothing is sent until every one of these is set.
# Practice mail must come from a different domain from EMAIL_FROM.
PRACTICE_EMAIL_DOMAIN=
PRACTICE_LINK_ORIGIN=https://practice.joinsafekeep.com
PRACTICE_POSTAL_ADDRESS=
# always (default) or easy_only (the "Safekeep practice message" line on difficulty 1-2 only, once counsel agrees).
PRACTICE_FOOTER=always
PRACTICE_SENDING=off
# SendGrid signed Event Webhook verification key, for /api/practice/events.
SENDGRID_WEBHOOK_PUBLIC_KEY=
# Weekly Scam Alert engine. The drafting job reads content from GitHub and opens the review pull request.
ANTHROPIC_API_KEY=
ALERT_MODEL=claude-opus-5-5
GITHUB_TOKEN=
GITHUB_REPO=joinsafekeep/safekeep
ALERTS_JOB_SECRET=
ALERTS_POSTAL_ADDRESS=
# Optional Stripe Checkout settings.
STRIPE_AUTOMATIC_TAX=false
STRIPE_TERMS_AT_CHECKOUT=false
